            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentSelectionResponse"
                }
              }
            }
          },
          "default": {
            "description": "Safe permission, stale-claim, validation, capability, conflict or upstream-unavailable error. No private provider values.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContentSelectionInput"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/CSRFToken"
          }
        ]
      }
    },
