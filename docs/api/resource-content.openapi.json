{
  "openapi": "3.0.3",
  "info": {
    "title": "OhMyCine Resource Content, Follow Defaults and Version Upgrade API",
    "version": "resource-content-v1",
    "description": "Scoped additive API contract. Existing API authentication, current resource permissions and standard envelopes apply. No endpoint accepts native provider IDs or raw torrent indexes as browser authority. Publication/deployment and real provider acceptance are separate."
  },
  "paths": {
    "/api/v1/discovery/content-preview": {
      "post": {
        "operationId": "sessionContentPreview",
        "summary": "Read actual resource files without submitting a download. Discovery permission; cloud reads also require authorized download/account association.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success; standard code/message/data envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentPreviewResponse"
                }
              }
            }
          },
          "default": {
            "description": "Safe permission, stale-claim, validation, capability, conflict or upstream-unavailable error. No private provider values.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContentPreviewInput"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/CSRFToken"
          }
        ]
      }
    },
    "/api/v1/discovery/content-selection": {
      "post": {
