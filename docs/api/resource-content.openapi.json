              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "omc_session"
      },
      "secureSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-omc_session"
      },
      "playerDevice": {
        "type": "http",
        "scheme": "bearer",
        "description": "Existing authorized Player device token, scoped to the configured Server origin."
      }
    },
    "schemas": {
      "ContentPreviewInput": {
        "type": "object",
        "properties": {
          "result_token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          },
          "downloader_id": {
            "type": "string",
            "description": "Optional legacy authorized association; does not grant account access."
          },
          "preview_token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          }
        },
        "required": [
          "result_token"
        ],
        "additionalProperties": false
      },
      "ContentSelectionInput": {
        "type": "object",
        "properties": {
          "result_token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          },
          "preview_token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          },
          "selected_entry_tokens": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
            },
            "minItems": 1,
            "maxItems": 500
          },
          "selection_token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          }
        },
        "required": [
          "result_token",
          "preview_token",
          "selected_entry_tokens"
        ],
        "additionalProperties": false
      },
      "SubtitleEvidence": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          },
          "script": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "Evidence level such as release_claim or sidecar_filename; no implied verified embedded stream."
          }
        },
        "required": [
          "language",
          "source"
        ]
      },
      "ContentFile": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          },
          "path": {
            "type": "string",
            "description": "Safe resource-relative path, never a local absolute path."
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "is_dir": {
            "type": "boolean"
          },
          "file_kind": {
            "type": "string",
            "enum": [
              "directory",
              "video",
              "subtitle",
              "archive",
              "other"
            ]
          },
          "season": {
            "type": "integer"
          },
          "episodes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "work_status": {
            "type": "string"
          },
          "unresolved_reason": {
            "type": "string"
          },
          "subtitles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubtitleEvidence"
            }
          }
        },
        "required": [
          "path",
          "name",
          "size",
          "is_dir",
          "file_kind",
          "episodes",
          "work_status"
        ]
      },
      "ContentPreview": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          },
          "status": {
            "type": "string"
          },
          "complete": {
            "type": "boolean"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentFile"
            }
          },
          "analysis": {
            "type": "object",
            "properties": {},
            "description": "Existing SiteShareAnalysis with exact sparse groups; file enumeration and metadata recognition are independent."
          },
          "total_count": {
            "type": "integer",
            "minimum": 0
          },
          "displayed_count": {
            "type": "integer",
            "minimum": 0
          },
          "next_offset": {
            "type": "integer",
            "minimum": 0
          },
          "total_size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "status",
          "complete",
          "files",
          "total_count",
          "displayed_count",
          "total_size",
          "checked_at",
          "expires_at",
          "message"
        ]
      },
      "ContentSelection": {
        "type": "object",
        "properties": {
          "selection_token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          },
          "preview_token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          },
          "selected_entry_tokens": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
            },
            "maxItems": 500
          },
          "file_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "video_count": {
            "type": "integer",
            "minimum": 0
          },
          "total_size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "selected_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "selection_token",
          "preview_token",
          "selected_entry_tokens",
          "file_count",
          "video_count",
          "total_size",
          "selected_bytes"
        ]
      },
      "UpgradeSearch": {
        "type": "object",
        "properties": {
          "tmdb_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "media_type": {
            "type": "string",
            "enum": [
              "movie",
              "tv"
            ]
          },
          "title": {
            "type": "string"
          },
          "season": {
            "type": "integer"
          },
          "episode": {
            "type": "integer"
          }
        },
        "required": [
          "tmdb_id",
          "media_type",
          "title"
        ]
      },
      "MediaUpgrade": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "library_id": {
            "type": "integer",
            "minimum": 1
          },
          "entry_id": {
            "type": "integer",
            "minimum": 1
          },
          "work_token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          },
          "title": {
            "type": "string"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "movie",
              "tv"
            ]
          },
          "tmdb_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "season": {
            "type": "integer"
          },
          "episode": {
            "type": "integer"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "search": {
            "$ref": "#/components/schemas/UpgradeSearch"
          },
          "recycle_supported": {
            "type": "boolean"
          },
          "error_code": {
            "type": "string"
          },
          "error_message": {
            "type": "string"
          },
          "download_task_id": {
            "type": "string"
          },
          "transfer_task_id": {
            "type": "string"
          },
          "next_attempt_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "state",
          "stage",
          "library_id",
          "entry_id",
          "work_token",
          "title",
          "media_type",
          "tmdb_id",
          "revision",
          "expires_at",
          "search",
          "recycle_supported"
        ]
      },
      "UpgradeSubmitInput": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "result_token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          },
          "downloader_id": {
            "type": "string"
          },
          "content_selection_token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          },
          "preview_token": {
            "type": "string",
            "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
          },
          "selected_entry_tokens": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Short-lived opaque actor/resource/configuration-bound token; keep only in memory."
            },
            "maxItems": 500
          },
          "priority": {
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "result_token",
          "downloader_id"
        ],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
