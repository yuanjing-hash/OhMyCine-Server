            }
          }
        ]
      }
    },
    "/api/v1/media-upgrades/{upgrade}/submit": {
      "post": {
        "operationId": "submitMediaVersionUpgrade",
        "summary": "Acquire a replacement; recycle captured old video/exclusive subtitles only after exact new import and required artifacts are ready.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "202": {
            "description": "Success; standard code/message/data envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaUpgradeResponse"
                }
              }
            }
          },
          "default": {
            "description": "Safe permission, stale-claim, validation, capability, conflict or upstream-unavailable error. No private provider values.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpgradeSubmitInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "upgrade",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/CSRFToken"
          }
        ]
      }
    },
    "/api/v1/settings/follows": {
      "get": {
        "operationId": "getFollowPolicyDefaults",
        "summary": "Read defaults for new subscriptions; settings.read required. New initial default prefers zh-Hans then zh-Hant, allowing missing subtitles with a warning.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success; standard code/message/data envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FollowPolicyDefaultsResponse"
                }
              }
            }
          },
          "default": {
            "description": "Safe validation, permission, stale revision, capability or upstream error. No credentials or native identifiers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateFollowPolicyDefaults",
        "summary": "Save default subtitle policy using revision CAS; settings.update and CSRF required. Existing subscription snapshots are unchanged.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success; standard code/message/data envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FollowPolicyDefaultsResponse"
                }
              }
            }
          },
          "default": {
            "description": "Safe validation, permission, stale revision, capability or upstream error. No credentials or native identifiers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFollowPolicyDefaultsInput"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/CSRFToken"
          }
        ]
      }
    },
    "/api/v1/discovery/downloads": {
      "post": {
        "operationId": "sessionCreateContentDownload",
        "summary": "Accept a frozen actual-file selection or explicit manual whole-resource intent. Current discovery/download, resource, receiver and target permissions are revalidated. Body limit 128 KiB.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success; standard code/message/data envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadResultResponse"
                }
              }
            }
          },
          "default": {
            "description": "Safe validation, permission, stale revision, capability or upstream error. No credentials or native identifiers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscoveryAcquisitionInput"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/CSRFToken"
          }
        ]
      }
    },
    "/api/v1/player/discovery/downloads": {
      "post": {
        "operationId": "playerCreateContentDownload",
        "summary": "Accept a frozen actual-file selection or explicit manual whole-resource intent. Current discovery/download, resource, receiver and target permissions are revalidated. Body limit 128 KiB.",
        "security": [
          {
            "playerDevice": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success; standard code/message/data envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadResultResponse"
                }
              }
            }
          },
          "default": {
            "description": "Safe validation, permission, stale revision, capability or upstream error. No credentials or native identifiers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscoveryAcquisitionInput"
              }
            }
          }
        }
      }
    },
    "/api/v1/discovery/results/link": {
      "post": {
        "operationId": "sessionDiscoveryResultLink",
        "summary": "Copy the actual recognized public resource link from a current owned result token. No source fetch, metadata task or download submission.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscoveryResultLinkInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success in the standard envelope; Cache-Control: no-store. Existing discovery.read, current Site/source/actor scope and expiry checks apply.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryResultLinkResponse"
                }
              }
            }
          },
          "default": {
            "description": "Safe permission, expired-source or actual public-link-unavailable error. No private URL, header or credential is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/CSRFToken"
          }
        ]
      }
    },
    "/api/v1/player/discovery/results/link": {
      "post": {
        "operationId": "playerDiscoveryResultLink",
        "summary": "Copy the actual recognized public resource link from a current owned result token. No source fetch, metadata task or download submission.",
        "security": [
          {
            "playerDevice": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscoveryResultLinkInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success in the standard envelope; Cache-Control: no-store. Existing discovery.read, current Site/source/actor scope and expiry checks apply.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryResultLinkResponse"
                }
              }
            }
          },
          "default": {
            "description": "Safe permission, expired-source or actual public-link-unavailable error. No private URL, header or credential is returned.",
            "content": {
