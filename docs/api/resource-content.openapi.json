    "/api/v1/media-libraries/{id}/catalog/{work}/entries/{entry}/upgrade-preview": {
      "post": {
        "operationId": "prepareMediaVersionUpgrade",
        "summary": "Prepare replacement of one exact catalog version. Does not recycle the old file.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success; standard code/message/data envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaUpgradeResponse"
                }
              }
            }
          },
          "default": {
            "description": "Safe permission, stale-claim, validation, capability, conflict or upstream-unavailable error. No private provider values.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "work",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entry",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "$ref": "#/components/parameters/CSRFToken"
          }
        ]
      }
    },
    "/api/v1/media-upgrades/{upgrade}": {
      "get": {
        "operationId": "getMediaVersionUpgrade",
        "summary": "Read authorized replacement and delayed-recycle status.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
